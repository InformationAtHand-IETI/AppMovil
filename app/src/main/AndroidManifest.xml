<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos necesarios -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InformationAtHand"
        tools:targetApi="31">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyA4Smxp0VFyjh0hJ1ePUx5B9i8ypdISyF0" />

        <!-- Obligatorio para Microsoft Entra ID (MSAL) -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true"
            tools:replace="android:configChanges"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Redirect URI EXACTA -->
                <data
                    android:scheme="msauth"
                    android:host="edu.eci.co.informationathand"
                    android:path="/x7OdxCT9V+jYhckI226LQHiGhro=" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="Parchesec"
            android:theme="@style/Theme.InformationAtHand">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla principal -->
        <activity
            android:name=".MainMapActivity"
            android:exported="false"
            android:label="Information At Hand"
            android:theme="@style/Theme.InformationAtHand" />

        <!-- Pantalla de detalle -->
        <activity
            android:name=".DetalleReporteActivity"
            android:exported="false"
            android:label="Detalle del Reporte"
            android:parentActivityName=".MainMapActivity"
            android:theme="@style/Theme.InformationAtHand">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainMapActivity" />
        </activity>

    </application>

</manifest>
