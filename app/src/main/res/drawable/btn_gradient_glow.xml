<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BRILLO EXTERIOR INTENSO -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <solid android:color="#FF00B4D8" />
        </shape>
    </item>

    <!-- SEGUNDO NIVEL DE BRILLO -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="33dp" />
            <solid android:color="#CC00C4E8" />
        </shape>
    </item>

    <!-- CONTORNO AZUL OSCURO DEFINIDO -->
    <item
        android:top="3dp"
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke
                android:width="3dp"
                android:color="#00274D" />
            <solid android:color="#00B4D8" />
        </shape>
    </item>

    <!-- GRADIENTE PRINCIPAL BRILLANTE -->
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient
                android:angle="90"
                android:startColor="#00D4FF"
                android:centerColor="#00B4D8"
                android:endColor="#0096C7"
                android:type="linear" />
        </shape>
    </item>

    <!-- BRILLO SUPERIOR MÁS INTENSO -->
    <item
        android:top="8dp"
        android:bottom="42dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#99FFFFFF"
                android:centerColor="#4DFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

</layer-list>