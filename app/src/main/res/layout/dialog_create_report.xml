<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:padding="24dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Título -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reporte"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Subtítulo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ingresa los detalles del incidente"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <!-- Dirección -->
                <TextView
                    android:id="@+id/tvReportAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Buscando dirección..."
                    android:textSize="14sp"
                    android:textColor="#1A237E"
                    android:layout_marginBottom="20dp"
                    android:padding="12dp"
                    android:background="@android:color/darker_gray"
                    android:drawableStart="@android:drawable/ic_dialog_map"
                    android:drawablePadding="8dp" />

                <!-- Campo Título -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Título del reporte"
                    app:startIconDrawable="@android:drawable/ic_dialog_info"
                    app:startIconTint="#1A237E"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReportTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Descripción -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Descripción detallada"
                    app:startIconDrawable="@android:drawable/ic_menu_edit"
                    app:startIconTint="#1A237E"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReportDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="4"
                        android:maxLines="8"
                        android:gravity="top"
                        android:background="@android:color/transparent"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnCancelReport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="Cancelar"
                        android:textColor="#666666"
                        android:backgroundTint="@android:color/transparent" />

                    <Button
                        android:id="@+id/btnSendReport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enviar Reporte"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1A237E"
                        android:paddingHorizontal="24dp"/>
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
