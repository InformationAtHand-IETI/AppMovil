<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerChat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón volver -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1A237E"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Nombre del chat -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Crear Chat Comunitario"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="12dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <EditText
        android:id="@+id/etChatName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nombre del chat"
        android:inputType="text"
        android:textColor="#000000"
        android:textColorHint="#CCCCCC"
        app:layout_constraintTop_toBottomOf="@id/headerChat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="20sp"
        android:maxLength="60"
        android:layout_marginTop="24dp"/>

    <EditText
        android:id="@+id/etZone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Zona (Norte, Centro, Sur, etc.)"
        android:inputType="text"
        android:textSize="20sp"
        android:textColor="#000000"
        android:textColorHint="#CCCCCC"
        android:maxLength="60"
        app:layout_constraintTop_toBottomOf="@id/etChatName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Barrio -->
    <EditText
        android:id="@+id/etNeighborhood"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Barrio"
        android:inputType="text"
        android:textSize="20sp"
        android:maxLength="60"
        android:textColor="#000000"
        android:textColorHint="#CCCCCC"
        app:layout_constraintTop_toBottomOf="@id/etZone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Botón crear chat -->
    <Button
        android:id="@+id/btnCreateChat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Crear Chat"
        android:textColor="#ffffff"
        android:backgroundTint="#1A237E"
        app:layout_constraintTop_toBottomOf="@id/etNeighborhood"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
